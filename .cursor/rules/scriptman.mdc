## Implementation Patterns

**Thread-Safe Singletons:**
```python
from threading import Lock

class CacheManager:
    _instance: "CacheManager | None" = None
    _lock: Lock = Lock()
    __initialized: bool = False

    def __new__(cls) -> "CacheManager":
        if cls._instance is None:
            with cls._lock:
                if cls._instance is None:
                    cls._instance = super().__new__(cls)
        return cls._instance

    def __init__(self) -> None:
        if self.__initialized:
            return
        # ... initialization ...
        self.__initialized = True
```

**Context Manager for Temporary State:**
```python
from contextlib import contextmanager
from typing import Iterator

@contextmanager
def temporary(self, **kwargs: Any) -> Iterator[None]:
    """🔄 Context manager for temporary overrides."""
    previous = self._overrides.copy()
    self.override(**kwargs)
    try:
        yield
    finally:
        self._overrides = previous
```

**ABC-Based Extensibility:**
```python
from abc import ABC, abstractmethod

class ConfigReader(ABC):
    """📖 Base class for configuration readers."""

    @property
    @abstractmethod
    def name(self) -> str:
        """🏷️ Reader identifier (e.g., 'toml', 'yaml')."""
        ...

    @abstractmethod
    def read(self) -> dict[str, Any]:
        """🔍 Load configuration as dictionary."""
        ...

    @abstractmethod
    def write(self, data: dict[str, Any]) -> None:
        """✍️ Persist configuration."""
        ...

    # Shared implementation available to all subclasses
    def exists(self) -> bool:
        """🔍 Check if config source exists."""
        if self.file_path is None:
            return True
        return self.file_path.exists()
```

**Sync/Async Decorator Pattern (The @overload Approach):**

All Scriptman decorators follow ONE pattern: use `@overload` to provide perfect types while preserving sync/async nature.

```python
from collections.abc import Callable, Coroutine
from functools import wraps
from typing import Any, ParamSpec, TypeVar, cast, overload

from scriptman.types import is_async

P = ParamSpec("P")
R = TypeVar("R")
T = TypeVar("T")

# Example: A retry decorator with proper types
@overload
def retry(
    max_retries: int = 3,
) -> Callable[[Callable[P, Coroutine[Any, Any, T]]], Callable[P, Coroutine[Any, Any, T]]]: ...
@overload
def retry(
    max_retries: int = 3,
) -> Callable[[Callable[P, R]], Callable[P, R]]: ...
def retry(max_retries: int = 3):
    """🔄 Retry decorator that preserves sync/async nature."""

    def decorator(func: Callable[P, R]) -> Callable[P, R]:
        if is_async(func):
            @wraps(func)
            async def async_wrapper(*args: P.args, **kwargs: P.kwargs) -> Any:
                last_exception: Exception | None = None
                for attempt in range(max_retries):
                    try:
                        return await func(*args, **kwargs)  # type: ignore[misc]
                    except Exception as e:
                        last_exception = e
                        if attempt < max_retries - 1:
                            import asyncio
                            await asyncio.sleep(1.0 * (2 ** attempt))
                raise last_exception
            return cast(Callable[P, R], async_wrapper)
        else:
            @wraps(func)
            def sync_wrapper(*args: P.args, **kwargs: P.kwargs) -> R:
                last_exception: Exception | None = None
                for attempt in range(max_retries):
                    try:
                        return func(*args, **kwargs)
                    except Exception as e:
                        last_exception = e
                        if attempt < max_retries - 1:
                            import time
                            time.sleep(1.0 * (2 ** attempt))
                raise last_exception  # type: ignore[misc]
            return sync_wrapper
    return decorator

# Usage - ONE decorator, correct types!
@retry(max_retries=3)
def fetch_data(): ...           # Type: () -> ReturnType

@retry(max_retries=3)
async def fetch_data_async(): ...  # Type: () -> Coroutine[Any, Any, ReturnType]
```

**Full documentation:** See `docs/sync-async-decorators.md` for the complete guide.

## Reference Implementation Style

Use this template when building new services, runners, CLI commands, or any workflow that performs side effects. It captures the Scriptman "zen": emoji-first docstrings, explicit options objects, no global state mutations, friendly summaries, and structured error handling.

```python
from pydantic import BaseModel
from loguru import logger


class FooOptions(BaseModel):
    """⚙️ Configure Foo execution parameters.

    Args:
        name: Identifier for the Foo resource.
        environment: Optional execution environment override.
        dry_run: When True, apply no mutations.
        retries: Number of retry attempts for Foo operations.
    """

    name: str
    environment: str | None = None
    dry_run: bool = False
    retries: int = 3


class FooRunner:
    """🚀 Manage Foo resources with explicit options and friendly summaries."""

    def __init__(self, options: FooOptions) -> None:
        """🚀 Store per-run options and bind contextual logging.

        Args:
            options: Configuration for this Foo execution.
        """
        # Public: Part of the API
        self.options = options

        # Protected: Internal but may be useful to subclasses
        self._logger = logger.bind(component="foo-runner")

    def run(self) -> int:
        """🚀 Execute the Foo workflow and report success or failure.

        Returns:
            0 on success, 1 when an exception is encountered.
        """
        try:
            resource = self._configure_resource()
            self._apply_changes(resource)
            self._summarize(resource)
            return 0
        except Exception as exc:
            self._logger.error(f"⚠️ Foo run failed: {exc}")
            return 1

    def _configure_resource(self) -> FooResource:
        """⚙️ Build the Foo resource from the provided options.

        Returns:
            A FooResource configured with the current options.
        """
        return FooResource(
            name=self.options.name,
            dry_run=self.options.dry_run,
            retries=self.options.retries,
            environment=self.options.environment or "default",
        )

    def _apply_changes(self, resource: FooResource) -> None:
        """✍️ Apply changes to the Foo resource (honouring dry-run mode).

        Args:
            resource: The resource being manipulated.

        Raises:
            FooError: When the underlying Foo operation fails.
        """
        if resource.dry_run:
            self._logger.info("✍️ Dry run mode; skipping mutations")
            return
        retry(resource.retries)(resource.apply)()

    def _summarize(self, resource: FooResource) -> None:
        """✅ Emit a friendly summary with next steps.

        Args:
            resource: The resource that just finished processing.
        """
        self._logger.success(
            "✅ Foo completed\n"
            "--------------------------------------------------\n"
            f"💡 Resource: {resource.name}\n"
            f"💡 Environment: {resource.environment}\n"
            f"💡 Dry Run: {'Yes' if resource.dry_run else 'No'}\n"
            "--------------------------------------------------\n"
            f"💡 Next: foo inspect --name {resource.name}\n"
        )
```

### Visual Rhythm ("Cascade")

Match the stepped layout used across Scriptman: lead with the longest concept, narrow to supporting details, and finish with the tightest lines. This "cascade" makes logs and summaries scannable and keeps diffs clean. Prefer:

```
Primary statement……………………
Secondary detail…………………
Tertiary reminder………………
```

over dense paragraphs or unordered bullets.

## Config System Conventions

**Import Patterns:**
```python
# For repeated use - import the singleton
from scriptman import config
config.get("log_level")
config.set("log_level", "DEBUG")

# For module-level access
import scriptman
scriptman.config.get("log_level")
```

### Logging Format Configuration

**Available Format Presets:**
| Preset       | Description                            | Use Case                       |
| ------------ | -------------------------------------- | ------------------------------ |
| `minimal`    | `{level.icon} {message}`               | Clean, emoji-only              |
| `simple`     | Time + level + message **(default)**   | Development                    |
| `detailed`   | Full context with module:function:line | Debugging                      |
| `json`       | Structured JSON                        | Log aggregation (Datadog, ELK) |
| `production` | Clean, no colors                       | File logging                   |

**Configuration via `scriptman.json` (default) or `scriptman.toml` (with extras):**
```json
{
  "logging": {
    "level": "DEBUG",
    "format": "detailed",
    "colorize": true,
    "diagnose": true,
    "backtrace": true,
    "file_enabled": true,
    "file_rotation": "10 MB",
    "file_retention": "7 days",
    "file_compression": "zip"
  }
}
```

Or with TOML (requires `pip install scriptman[toml]`):
```toml
[logging]
level = "DEBUG"
format = "detailed"
colorize = true
```

**Configuration via Code:**
```python
from scriptman import observe

# Use a preset
observe.configure_logging(format="minimal", level="DEBUG")

# Use custom format string (loguru syntax)
observe.configure_logging(format="{time:HH:mm} | {level.icon} | {message}")

# Auto-configure from scriptman.toml
observe.configure_from_config()

# Add file logging
observe.add_file_handler(".data/logs/app.log", level="INFO", rotation="1 day")
```

**RULE: Format Presets Affect Message Structure Only**
Format presets control timestamp/level/module formatting. Data kwargs (` | key=value`) are always appended the same way for consistency across all formats.

**Access Patterns:**
```python
# ✅ Explicit access (preferred)
config.get("retry.max_delay")
config["retry.max_delay"]
config.set("log_level", "DEBUG")

# ❌ Magic attribute access (avoid)
config.retry.max_delay  # Don't do this
```

**Override Patterns:**
```python
# Runtime override (not persisted)
config.override(log_level="DEBUG")

# Temporary override (scoped)
with config.temporary(concurrent=False):
    # Runs with concurrent=False
    pass
# Original restored
```

## Environment & Commands

**Running Poetry and Python Tasks**
On this development machine, use `python -m` prefix for poetry and related commands:

```bash
# ✅ CORRECT - Use python -m prefix
python -m poetry install
python -m poetry run pytest
python -m poetry add package-name
python -m pytest tests/
python -m pip install package

# ❌ WRONG - Direct commands may not work
poetry install
pytest tests/
pip install package
```

This ensures the correct Python interpreter and virtual environment are used.

